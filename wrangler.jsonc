{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prompt-lab",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "send_metrics": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "2026102001", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8" },
  "observability": { "enabled": false }
}
